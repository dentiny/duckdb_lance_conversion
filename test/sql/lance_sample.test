# name: test/sql/lance_sample.test
# description: SAMPLE_PERCENT and SAMPLE_ROWS edge cases and validation
# group: [sql]

require lance_conversion

query I
COPY (SELECT i FROM range(10) t(i)) TO '__TEST_DIR__/sample_rows_all.lance' (FORMAT LANCE, SAMPLE_ROWS 1000);
----
10

query I
COPY (SELECT i FROM range(10) t(i)) TO '__TEST_DIR__/sample_rows_zero.lance' (FORMAT LANCE, SAMPLE_ROWS 0);
----
0

query I
COPY (SELECT i FROM range(100) t(i)) TO '__TEST_DIR__/sample_percent_zero.lance' (FORMAT LANCE, SAMPLE_PERCENT 0);
----
0

query I
COPY (SELECT i FROM range(100) t(i)) TO '__TEST_DIR__/sample_append.lance' (FORMAT LANCE, SAMPLE_ROWS 5);
----
5

query I
COPY (SELECT i FROM range(100, 200) t(i)) TO '__TEST_DIR__/sample_append.lance' (FORMAT LANCE, APPEND, SAMPLE_ROWS 3);
----
3

statement error
COPY (SELECT 1 AS i) TO '__TEST_DIR__/sample_bad.lance' (FORMAT LANCE, SAMPLE_ROWS 1, SAMPLE_PERCENT 10);
----
Only one of SAMPLE_PERCENT or SAMPLE_ROWS

statement error
COPY (SELECT 1 AS i) TO '__TEST_DIR__/sample_bad.lance' (FORMAT LANCE, SAMPLE_PERCENT 101);
----
SAMPLE_PERCENT must be between 0 and 100

statement error
COPY (SELECT 1 AS i) TO '__TEST_DIR__/sample_bad.lance' (FORMAT LANCE, SAMPLE_PERCENT -1);
----
SAMPLE_PERCENT must be between 0 and 100

statement error
COPY (SELECT 1 AS i) TO '__TEST_DIR__/sample_bad.lance' (FORMAT LANCE, SAMPLE_ROWS -1);
----
SAMPLE_ROWS must be non-negative

statement error
COPY (SELECT 1 AS i) TO '__TEST_DIR__/sample_bad.lance' (FORMAT LANCE, SAMPLE_ROWS);
----
SAMPLE_ROWS requires one non-negative integer

restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

query I
SELECT count(*) FROM '__TEST_DIR__/sample_rows_all.lance';
----
10

query I
SELECT count(*) FROM '__TEST_DIR__/sample_rows_zero.lance';
----
0

query II
SELECT count(*) FILTER (WHERE i < 100), count(*) FILTER (WHERE i >= 100)
FROM '__TEST_DIR__/sample_append.lance';
----
5	3
