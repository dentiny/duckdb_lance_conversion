# name: test/sql/lance_type_date.test
# description: Date round trip through Lance
# group: [sql]

require lance_conversion

query I
COPY (
    SELECT DATE '2024-02-29' AS value
    UNION ALL
    SELECT NULL::DATE
) TO '__TEST_DIR__/date.lance' (FORMAT LANCE);
----
2

restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

query II
SELECT
    count(*) FILTER (WHERE value = DATE '2024-02-29') = 1,
    count(*) FILTER (WHERE value IS NULL) = 1
FROM '__TEST_DIR__/date.lance';
----
true	true
