# name: test/sql/jsonl_source.test
# description: JSONL file to a Lance dataset
# group: [sql]

require lance_conversion

require json

statement ok
CREATE TABLE source_rows (id INTEGER, name VARCHAR, score DOUBLE);

statement ok
INSERT INTO source_rows VALUES
    (1, 'alpha', 1.5),
    (2, 'beta', NULL),
    (3, 'gamma', 2.25);

# DuckDB's non-array JSON output is newline-delimited JSON.
statement ok
COPY source_rows
TO '__TEST_DIR__/source.jsonl' (FORMAT JSON, ARRAY false);

query I
COPY (
    SELECT * FROM read_ndjson_auto('__TEST_DIR__/source.jsonl')
)
TO '__TEST_DIR__/jsonl_source.lance' (FORMAT LANCE);
----
3

query I
COPY (
    SELECT * FROM read_ndjson_auto('__TEST_DIR__/source.jsonl')
)
TO '__TEST_DIR__/jsonl_sample_rows.lance' (FORMAT LANCE, SAMPLE_ROWS 2);
----
2

query I
COPY (
    SELECT * FROM read_ndjson_auto('__TEST_DIR__/source.jsonl')
)
TO '__TEST_DIR__/jsonl_sample_percent.lance' (FORMAT LANCE, SAMPLE_PERCENT 100);
----
3

# Load the official Lance reader only after exercising our FORMAT LANCE writer.
restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

query ITT
SELECT id, name, score::VARCHAR
FROM '__TEST_DIR__/jsonl_source.lance'
ORDER BY id;
----
1	alpha	1.5
2	beta	NULL
3	gamma	2.25

query I
SELECT count(*) FROM '__TEST_DIR__/jsonl_sample_rows.lance';
----
2

query I
SELECT count(*) FROM '__TEST_DIR__/jsonl_sample_percent.lance';
----
3
