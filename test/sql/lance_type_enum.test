# name: test/sql/lance_type_enum.test
# description: ENUM round trip through Lance, including APPEND with a different ENUM definition
# group: [sql]

require lance_conversion

statement ok
CREATE TYPE mood AS ENUM ('sad', 'ok', 'happy');

query I
COPY (
    SELECT *
    FROM (VALUES ('happy'::mood, ['ok'::mood]), ('sad'::mood, []), (NULL::mood, NULL))
    t(m, moods)
) TO '__TEST_DIR__/enum.lance' (FORMAT LANCE);
----
3

# A different dictionary with the same key width (UINT8) is accepted.
statement ok
CREATE TYPE other_mood AS ENUM ('angry', 'ok');

query I
COPY (SELECT 'angry'::other_mood AS m, ['angry'::other_mood] AS moods)
TO '__TEST_DIR__/enum.lance' (FORMAT LANCE, APPEND);
----
1

# More than 255 values widens the dictionary key to UINT16, which Lance treats as a different type.
statement ok
CREATE TYPE wide_mood AS ENUM (SELECT 'v' || range::VARCHAR FROM range(300));

statement error
COPY (SELECT 'v1'::wide_mood AS m, ['v2'::wide_mood] AS moods)
TO '__TEST_DIR__/enum.lance' (FORMAT LANCE, APPEND);
----
Append with different schema

restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

query II
SELECT m::VARCHAR, moods::VARCHAR[] FROM '__TEST_DIR__/enum.lance' ORDER BY 1 NULLS LAST;
----
angry	[angry]
happy	[ok]
sad	[]
NULL	NULL
