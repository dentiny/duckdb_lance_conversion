# name: test/sql/lance_conversion.test
# description: Single Parquet file to a Lance dataset
# group: [sql]

require lance_conversion

require parquet

statement ok
COPY (SELECT i, CASE WHEN i % 7 = 0 THEN NULL ELSE 'row-' || i END AS text FROM range(5000) t(i)) TO '__TEST_DIR__/lance_input.parquet' (FORMAT PARQUET);

query I
COPY (SELECT * FROM read_parquet('__TEST_DIR__/lance_input.parquet')) TO '__TEST_DIR__/conversion.lance' (FORMAT LANCE);
----
5000

query I
SELECT count(*) > 0 FROM glob('__TEST_DIR__/conversion.lance/_versions/*');
----
true

statement error
COPY (SELECT 1 AS id) TO '__TEST_DIR__/conversion.lance' (FORMAT LANCE);
----
must not exist

query I
COPY (SELECT * FROM read_parquet('__TEST_DIR__/lance_input.parquet') WHERE i < 10) TO '__TEST_DIR__/conversion.lance' (FORMAT LANCE, OVERWRITE);
----
10

statement error
COPY (SELECT 1 AS id) TO '__TEST_DIR__/conversion.lance' (FORMAT LANCE, OVERWRITE false);
----
must not exist

statement error
COPY (SELECT 1 AS id) TO '__TEST_DIR__/unsupported.lance' (FORMAT LANCE, APPEND);
----
Unsupported option

statement error
COPY (SELECT 1::HUGEINT AS id) TO '__TEST_DIR__/unsupported.lance' (FORMAT LANCE);
----
does not support

query I
COPY (SELECT * FROM read_parquet('__TEST_DIR__/lance_input.parquet') WHERE false) TO '__TEST_DIR__/empty_conversion.lance' (FORMAT LANCE);
----
0

# Load the official Lance reader only after exercising our FORMAT LANCE writer.
restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

query IT
SELECT i, text FROM '__TEST_DIR__/conversion.lance' ORDER BY i;
----
0	NULL
1	row-1
2	row-2
3	row-3
4	row-4
5	row-5
6	row-6
7	NULL
8	row-8
9	row-9

query I
SELECT count(*) FROM '__TEST_DIR__/empty_conversion.lance';
----
0
