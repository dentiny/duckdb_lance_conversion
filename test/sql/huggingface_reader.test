# name: test/sql/huggingface_reader.test
# description: Verify read_huggingface registration and argument validation
# group: [sql]

require lance_conversion

statement ok
CREATE TEMPORARY SECRET hf_test (
    TYPE HUGGINGFACE,
    TOKEN 'test-token',
    SCOPE 'hf://datasets/owner/dataset'
);

query T
SELECT type FROM duckdb_secrets() WHERE name = 'hf_test';
----
huggingface

statement error
SELECT * FROM read_huggingface('');
----
dataset, config, and split must not be empty

statement error
SELECT * FROM read_huggingface('owner/dataset', config := '');
----
dataset, config, and split must not be empty

statement error
SELECT * FROM read_huggingface('owner/dataset', split := '');
