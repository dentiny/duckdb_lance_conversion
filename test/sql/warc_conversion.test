# name: test/sql/warc_conversion.test
# description: WARC and compressed WARC to Lance datasets
# group: [sql]

require lance_conversion

query I
COPY (
    SELECT * FROM read_warc('test/data/records.warc')
) TO '__TEST_DIR__/warc.lance' (FORMAT LANCE);
----
2

query I
COPY (
    SELECT * FROM read_warc('test/data/records.warc.gz')
) TO '__TEST_DIR__/warc_gzip.lance' (FORMAT LANCE);
----
2

statement ok
PREPARE warc_scan AS SELECT count(*) FROM read_warc('test/data/records.warc');

query I
EXECUTE warc_scan;
----
2

query I
EXECUTE warc_scan;
----
2

query TTI rowsort
SELECT type, id, epoch_ms(date)
FROM read_warc('test/data/records.warc', max_read_parallelism = 2);
----
response	<urn:uuid:1>	1704164645000
response	<urn:uuid:2>	1704164646000

query I
SELECT count(*)
FROM read_warc(
    'test/data/records.warc.gz',
    index_path = 'test/data/records.cdxj',
    max_read_parallelism = 2
);
----
2

statement error
SELECT *
FROM read_warc('test/data/records.warc', max_read_parallelism = 0);
----
max_read_parallelism must be positive

restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

query TIITT rowsort
SELECT id, content_length, epoch_ms(date), type, content_type
FROM '__TEST_DIR__/warc.lance';
----
<urn:uuid:1>	5	1704164645000	response	application/octet-stream
<urn:uuid:2>	6	1704164646000	response	application/octet-stream

query I
SELECT count(*) FROM '__TEST_DIR__/warc_gzip.lance';
----
2
