# name: test/sql/warc_conversion.test
# description: WARC and compressed WARC to Lance datasets
# group: [sql]

require lance_conversion

statement ok
SET threads = 4;

# read_warc supports batch indexes, so an order-preserving COPY runs in parallel.
query II
EXPLAIN COPY (SELECT * FROM read_warc('test/data/records.warc')) TO '__TEST_DIR__/warc_explain.lance' (FORMAT LANCE);
----
physical_plan	<REGEX>:.*BATCH_COPY_TO_FILE.*

query I
COPY (
    SELECT * FROM read_warc('test/data/records.warc')
) TO '__TEST_DIR__/warc.lance' (FORMAT LANCE);
----
2

query I
COPY (
    SELECT * FROM read_warc('test/data/records.warc.gz')
) TO '__TEST_DIR__/warc_gzip.lance' (FORMAT LANCE);
----
2

query I
COPY (
    SELECT * FROM read_warc('test/data/records.warc')
) TO '__TEST_DIR__/warc_sample_rows.lance' (FORMAT LANCE, SAMPLE_ROWS 1);
----
1

query I
COPY (
    SELECT * FROM read_warc('test/data/records.warc.gz')
) TO '__TEST_DIR__/warc_sample_percent.lance' (FORMAT LANCE, SAMPLE_PERCENT 100);
----
2

statement ok
PREPARE warc_scan AS SELECT count(*) FROM read_warc('test/data/records.warc');

query I
EXECUTE warc_scan;
----
2

query I
EXECUTE warc_scan;
----
2

query TTI rowsort
SELECT type, id, epoch_ms(date)
FROM read_warc('test/data/records.warc', max_read_parallelism = 2);
----
response	<urn:uuid:1>	1704164645000
response	<urn:uuid:2>	1704164646000

query I
SELECT count(*)
FROM read_warc(
    'test/data/records.warc.gz',
    index_path = 'test/data/records.cdxj',
    max_read_parallelism = 2
);
----
2

statement error
SELECT *
FROM read_warc('test/data/records.warc', max_read_parallelism = 0);
----
max_read_parallelism must be positive

# A Common Crawl segment reads its files from the crawl's warc.paths.gz; the
# segment 10 entry does not exist and must be skipped.
query I
COPY (
    SELECT * FROM read_warc('test/data/crawl-data/CC-TEST/segments/1/')
) TO '__TEST_DIR__/warc_segment.lance' (FORMAT LANCE);
----
4

# The whole crawl includes the missing segment 10 file.
statement error
SELECT count(*) FROM read_warc('test/data/crawl-data/CC-TEST/warc.paths.gz');
----
crawl-data/CC-TEST/segments/10/warc/missing.warc

# `**` crosses directories; `*` stays within one.
query I
SELECT count(*) FROM read_warc('test/data/crawl-data/**/*.warc*');
----
4

query I
SELECT count(*) FROM read_warc('test/data/records.warc*');
----
4

statement error
SELECT count(*) FROM read_warc('test/data/records.warc*', index_path = 'test/data/records.cdxj');
----
index_path is not supported for WARC segments or glob patterns

statement error
SELECT * FROM read_warc('gs://bucket/archive.warc');
----
read_warc path supports only local, s3://, and http(s):// paths

restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

query TIITT rowsort
SELECT id, content_length, epoch_ms(date), type, content_type
FROM '__TEST_DIR__/warc.lance';
----
<urn:uuid:1>	5	1704164645000	response	application/octet-stream
<urn:uuid:2>	6	1704164646000	response	application/octet-stream

query I
SELECT count(*) FROM '__TEST_DIR__/warc_gzip.lance';
----
2

query I
SELECT count(*) FROM '__TEST_DIR__/warc_sample_rows.lance';
----
1

query I
SELECT count(*) FROM '__TEST_DIR__/warc_sample_percent.lance';
----
2

query I
SELECT count(*) FROM '__TEST_DIR__/warc_segment.lance';
----
4
