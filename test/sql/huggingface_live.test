# name: test/sql/huggingface_live.test
# description: Live Hugging Face reader to Lance COPY
# group: [sql]

require lance_conversion

query I
COPY (
    SELECT * FROM read_huggingface('lhoestq/demo1')
) TO '__TEST_DIR__/huggingface.lance' (FORMAT LANCE);
----
5

query I
SELECT count(*) > 0 FROM glob('__TEST_DIR__/huggingface.lance/_versions/*');
----
true

statement ok
PREPARE hf_scan AS SELECT count(*) FROM read_huggingface('lhoestq/demo1');

query I
EXECUTE hf_scan;
----
5

query I
SELECT count(*)
FROM read_huggingface(
    'lhoestq/demo1',
    preserve_insertion_order = false,
    max_read_parallelism = 2
);
----
5

statement error
SELECT *
FROM read_huggingface(
    'lhoestq/demo1',
    preserve_insertion_order = false,
    max_read_parallelism = 0
);
----
max_read_parallelism must be positive

query I
EXECUTE hf_scan;
----
5
