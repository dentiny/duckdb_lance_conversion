# name: test/sql/huggingface_live.test
# description: Live Hugging Face reader to Lance COPY
# group: [sql]

require lance_conversion

statement ok
SET threads = 4;

# read_huggingface supports batch indexes, so an order-preserving COPY runs in parallel.
query II
EXPLAIN COPY (SELECT * FROM read_huggingface('lhoestq/demo1')) TO '__TEST_DIR__/huggingface_explain.lance' (FORMAT LANCE);
----
physical_plan	<REGEX>:.*BATCH_COPY_TO_FILE.*

query I
COPY (
    SELECT * FROM read_huggingface('lhoestq/demo1')
) TO '__TEST_DIR__/huggingface.lance' (FORMAT LANCE);
----
5

query I
SELECT count(*) > 0 FROM glob('__TEST_DIR__/huggingface.lance/_versions/*');
----
true

statement ok
PREPARE hf_scan AS SELECT count(*) FROM read_huggingface('lhoestq/demo1');

query I
EXECUTE hf_scan;
----
5

query I
SELECT count(*)
FROM read_huggingface(
    'lhoestq/demo1',
    preserve_insertion_order = false,
    max_read_parallelism = 2
);
----
5

# Projected columns, selected out of file order, must match a full read.
statement ok
CREATE TABLE hf_full AS SELECT * FROM read_huggingface('lhoestq/demo1');

query I
SELECT count(*) FROM (
    SELECT star, id FROM read_huggingface('lhoestq/demo1')
    EXCEPT ALL
    SELECT star, id FROM hf_full
);
----
0

query I
SELECT count(*) FROM (
    SELECT version_id, package_name FROM read_huggingface('lhoestq/demo1', preserve_insertion_order = false)
    EXCEPT ALL
    SELECT version_id, package_name FROM hf_full
);
----
0

query I
SELECT count(star) FROM read_huggingface('lhoestq/demo1');
----
5

statement error
SELECT *
FROM read_huggingface(
    'lhoestq/demo1',
    preserve_insertion_order = false,
    max_read_parallelism = 0
);
----
max_read_parallelism must be positive

# Zero disables read-ahead; a budget smaller than any batch still reads every
# row, one batch at a time.
query I
SELECT count(*) FROM read_huggingface('lhoestq/demo1', read_ahead_bytes = 0);
----
5

query I
SELECT count(*) FROM read_huggingface('lhoestq/demo1', read_ahead_bytes = 1);
----
5

query I
EXECUTE hf_scan;
----
5

query I
COPY (
    SELECT * FROM read_huggingface('lhoestq/demo1')
) TO '__TEST_DIR__/huggingface_sample_rows.lance' (FORMAT LANCE, SAMPLE_ROWS 2);
----
2

query I
COPY (
    SELECT * FROM read_huggingface('lhoestq/demo1')
) TO '__TEST_DIR__/huggingface_sample_percent.lance' (FORMAT LANCE, SAMPLE_PERCENT 100);
----
5

restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

query I
SELECT count(*) FROM '__TEST_DIR__/huggingface_sample_rows.lance';
----
2

query I
SELECT count(*) FROM '__TEST_DIR__/huggingface_sample_percent.lance';
----
5
