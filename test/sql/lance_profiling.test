# name: test/sql/lance_profiling.test
# description: Source and destination metrics are reported through DuckDB profiling
# group: [sql]

require lance_conversion

require json

statement ok
SET profiling_coverage = 'ALL';

statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '__TEST_DIR__/lance_profile.json';

statement ok
SET tracked_metrics = ['operator.type', 'operator.rows_scanned', 'io.total_bytes_read', 'io.total_bytes_written'];

query I
COPY (
    SELECT * FROM read_warc('test/data/records.warc')
) TO '__TEST_DIR__/profiled.lance' (FORMAT LANCE);
----
2

statement ok
PRAGMA disable_profiling;

query II
SELECT io.total_bytes_read > 0, io.total_bytes_written > 0
FROM read_json_auto('__TEST_DIR__/lance_profile.json');
----
true	true

# Operator metrics vary by node, so walk JSON without inferring a recursive STRUCT type.
statement ok
CREATE VIEW profiled_operators AS
SELECT node.value->>'type' AS operator_type,
       (node.value->>'rows_scanned')::UBIGINT AS operator_rows_scanned
FROM read_json_objects('__TEST_DIR__/lance_profile.json') AS profile,
     json_tree(profile.json) AS node
WHERE node.type = 'OBJECT';

query I
SELECT sum(operator_rows_scanned)
FROM profiled_operators
WHERE operator_type = 'TABLE_SCAN';
----
2
