# name: test/sql/lance_blob_columns.test
# description: Write native BLOB values and ingest URI strings as Lance Blob v2 columns
# group: [sql]

require lance_conversion

query I
COPY (
    SELECT *
    FROM (VALUES
        (1, 'test/data/records.warc'),
        (2, NULL)
    ) t(id, uri)
) TO '__TEST_DIR__/blob_columns.lance' (
    FORMAT LANCE,
    BLOB_COLUMNS (uri)
);
----
2

query I
COPY (
    SELECT *
    FROM (VALUES
        (1, ''::BLOB),
        (2, unhex('0001020304')),
        (3, unhex('00FF10203040506070')),
        (4, NULL::BLOB)
    ) t(id, payload)
) TO '__TEST_DIR__/native_blobs.lance' (
    FORMAT LANCE,
    BLOB_INLINE_SIZE_THRESHOLD 4,
    BLOB_DEDICATED_SIZE_THRESHOLD 8
);
----
4

statement error
COPY (SELECT 'test/data/records.warc' AS uri) TO '__TEST_DIR__/missing_blob_column.lance' (
    FORMAT LANCE,
    BLOB_COLUMNS (missing)
);
----
BLOB_COLUMNS column not found

statement error
COPY (SELECT 1 AS uri) TO '__TEST_DIR__/invalid_blob_column.lance' (
    FORMAT LANCE,
    BLOB_COLUMNS (uri)
);
----
BLOB_COLUMNS column must be VARCHAR

restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

query I
SELECT count(*) FROM '__TEST_DIR__/blob_columns.lance';
----
2

query II
SELECT
    count(*) = 4,
    count(*) FILTER (
        WHERE CASE id
            WHEN 1 THEN payload = ''::BLOB
            WHEN 2 THEN hex(payload) = '0001020304'
            WHEN 3 THEN hex(payload) = '00FF10203040506070'
            WHEN 4 THEN payload IS NULL
            ELSE false
        END
    ) = 4
FROM '__TEST_DIR__/native_blobs.lance';
----
true	true
