# name: test/sql/xml_conversion.test
# description: NOAA weather station XML, plain or gzipped, to Lance datasets
# group: [sql]

require lance_conversion

# test/data/noaa_stations_al.xml is the Alabama slice of NOAA's station index.
# Inferred columns are sorted by element name, and every inferred column is nullable.
query TT
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM read_xml_records('test/data/noaa_stations_al.xml',
                                      record_element := '/wx_station_index/station'));
----
html_url	VARCHAR
latitude	DOUBLE
longitude	DOUBLE
rss_url	VARCHAR
state	VARCHAR
station_id	VARCHAR
station_name	VARCHAR
xml_url	VARCHAR

query IIRRRRR
SELECT count(*), count(DISTINCT station_id), min(latitude), max(latitude), round(avg(latitude), 4),
       min(longitude), max(longitude)
FROM read_xml_records('test/data/noaa_stations_al.xml', record_element := '/wx_station_index/station')
WHERE state = 'AL';
----
46	46	30.2896	34.86139	32.6914	-88.24556	-85.129

# Entity references decode, and projections may reorder columns.
query TRRT
SELECT station_name, latitude, longitude, xml_url
FROM read_xml_records('test/data/noaa_stations_al.xml', record_element := '/wx_station_index/station')
WHERE station_id = 'KJFX';
----
Jasper Walker County Airport & Bevill Field	33.902	-87.31417	https://forecast.weather.gov/xml/current_obs/KJFX.xml

# The gzipped copy decodes to the same records.
query I
SELECT count(*)
FROM read_xml_records('test/data/noaa_stations_al.xml.gz', record_element := '/wx_station_index/station') g
JOIN read_xml_records('test/data/noaa_stations_al.xml', record_element := '/wx_station_index/station') p
USING (station_id, station_name, latitude, longitude);
----
46

query I
COPY (SELECT * FROM read_xml_records('test/data/noaa_stations_al.xml.gz', record_element := '/wx_station_index/station'))
TO '__TEST_DIR__/noaa_stations.lance' (FORMAT LANCE);
----
46

statement error
SELECT * FROM read_xml_records('test/data/noaa_stations_al.xml');
----
read_xml_records requires record_element

statement error
SELECT * FROM read_xml_records('test/data/noaa_stations_al.xml', record_element := '/wx_station_index/missing');
----
matched no fields

statement error
SELECT * FROM read_xml_records('test/data/noaa_stations_al.xml', record_element := 'station');
----
XML reader

statement error
SELECT * FROM read_xml_records('test/data/records.warc', record_element := '/rows/row');
----
XML

# Load the official Lance reader only after exercising our FORMAT LANCE writer.
restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

query ITT
SELECT count(*), max(station_id), min(station_name)
FROM '__TEST_DIR__/noaa_stations.lance';
----
46	KTOI	Alabaster, Shelby County Airport

query TRR
SELECT station_name, latitude, longitude
FROM '__TEST_DIR__/noaa_stations.lance'
WHERE station_id = 'KMDQ';
----
Huntsville, Madison County Executive Airport	34.86139	-86.55722
