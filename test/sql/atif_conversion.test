# name: test/sql/atif_conversion.test
# description: ATIF trajectory JSON and JSONL, plain or gzipped, to Lance datasets
# group: [sql]

load {TEST_DIR}/atif_metadata.duckdb

require lance_conversion

# One scan covers JSONL/gzip, explicit format, provenance, and nested fields.
query TITII
SELECT trajectory_id, source_record_index, agent.name,
       len(steps), steps[2].metrics.prompt_tokens
FROM read_atif('test/data/trajectories.jsonl.gz', format = 'jsonl')
ORDER BY source_record_index;
----
t1	1	example	2	10
t2	2	example	1	NULL

# Exercise nested compression options and write the dataset used by the round trip.
query I
COPY (SELECT * FROM read_atif('test/data/trajectories.jsonl'))
TO '__TEST_DIR__/atif.lance' (FORMAT LANCE,
    COLUMN_COMPRESSION {'STEPS.MESSAGE.TEXT': 'zstd', 'steps.observation.results.content.text': 'none'});
----
2

statement error
SELECT * FROM read_atif('test/data/trajectory.json', format = 'csv');
----
unsupported ATIF format

statement error
SELECT * FROM read_atif('test/data/records.warc', format = 'json');
----
ATIF read error

statement ok
SET preserve_insertion_order = false;

statement error
SELECT * FROM read_atif('test/data/trajectories.jsonl');
----
read_atif requires preserve_insertion_order = true

statement ok
RESET preserve_insertion_order;

# Check both message and observation payloads with the same assertions.
query IIT
SELECT parts[2].source.path = (SELECT content FROM read_blob('test/data/atif-image.png')),
       parts[3].source.path = (SELECT content FROM read_blob('test/data/atif-audio.wav')),
       decode(parts[1].text)
FROM (
    SELECT unnest([steps[1].message, steps[2].observation.results[1].content]) AS parts
    FROM read_atif('test/data/trajectory_media.json')
);
----
true	true	hello 你好🙂
true	true	RGB pattern and a 440 Hz tone.

query T
SELECT trajectory_id FROM read_atif('test/data/trajectory_missing_media.json');
----
media

statement error
SELECT steps FROM read_atif('test/data/trajectory_missing_media.json');
----
ATIF media

statement error
COPY (SELECT * FROM read_atif('test/data/trajectory.json'))
TO '__TEST_DIR__/invalid_atif_override.lance'
(FORMAT LANCE, COLUMN_COMPRESSION {'steps.message.missing': 'zstd'});
----
column not found

statement error
COPY (SELECT * FROM read_atif('test/data/trajectory.json'))
TO '__TEST_DIR__/invalid_atif_layout.lance'
(FORMAT LANCE, COLUMN_STRUCTURAL_ENCODING {'steps.message.text': 'fullzip'});
----
COLUMN_STRUCTURAL_ENCODING applies to top-level columns

# Source metadata must survive materialization, database reopen, nested extraction,
# and aliases. Text extracted as a top-level column must not become a media Blob.
statement ok
CREATE TABLE atif_staged AS SELECT * FROM read_atif('test/data/trajectory_media.json');

restart

query I
COPY (SELECT trajectory_id, source_record_index, steps AS renamed_steps FROM atif_staged)
TO '__TEST_DIR__/atif_media.lance' (FORMAT LANCE);
----
1

query I
COPY (SELECT steps[1].message[1].text AS body FROM atif_staged)
TO '__TEST_DIR__/atif_text.lance' (FORMAT LANCE);
----
1

# An identical struct shape without ATIF metadata must retain ordinary storage.
query I
COPY (SELECT {'type': 'text', 'text': 'plain'::BLOB,
              'source': {'media_type': 'image/png', 'path': 'bytes'::BLOB,
                         'duration_sec': 1.0::DOUBLE}} AS content)
TO '__TEST_DIR__/not_atif.lance' (FORMAT LANCE);
----
1

restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

# The pinned upstream reader binds the physical nested Blob schema but returns
# logical Blob descriptors, causing an Arrow child-count mismatch for steps.
# Keep its SQL round trip to metadata until the reader fixes that mismatch.
# rust/tests/atif_media.rs verifies full text/media round trips with the writer SDK.
query TI
SELECT trajectory_id, source_record_index FROM '__TEST_DIR__/atif.lance'
UNION ALL
SELECT trajectory_id, source_record_index FROM '__TEST_DIR__/atif_media.lance'
ORDER BY trajectory_id;
----
media	1
t1	1
t2	2

query T
SELECT decode(body) FROM '__TEST_DIR__/atif_text.lance';
----
hello 你好🙂

query TTT
SELECT decode(content.text), typeof(content.source.path), decode(content.source.path)
FROM '__TEST_DIR__/not_atif.lance';
----
plain	BLOB	bytes
