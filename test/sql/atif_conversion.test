# name: test/sql/atif_conversion.test
# description: ATIF trajectory JSON and JSONL, plain or gzipped, to Lance datasets
# group: [sql]

require lance_conversion

query TIT
SELECT trajectory_id, source_record_index, agent.name
FROM read_atif('test/data/trajectories.jsonl')
ORDER BY source_record_index;
----
t1	1	example
t2	2	example

query TII
SELECT trajectory_id, len(steps), steps[2].metrics.prompt_tokens
FROM read_atif('test/data/trajectories.jsonl')
ORDER BY trajectory_id;
----
t1	2	10
t2	1	NULL

query TT
SELECT trajectory_id, steps[1].message[1].text
FROM read_atif('test/data/trajectory.json');
----
single	hello

query I
SELECT count(*) FROM read_atif('test/data/trajectories.jsonl', format = 'jsonl');
----
2

query TII
SELECT trajectory_id, source_record_index, len(steps)
FROM read_atif('test/data/trajectories.jsonl.gz')
ORDER BY source_record_index;
----
t1	1	2
t2	2	1

query TT
SELECT trajectory_id, steps[1].message[1].text
FROM read_atif('test/data/trajectory.json.gz');
----
single	hello

query I
COPY (
    SELECT * FROM read_atif('test/data/trajectories.jsonl')
) TO '__TEST_DIR__/atif.lance' (FORMAT LANCE);
----
2

statement error
SELECT * FROM read_atif('test/data/records.warc');
----
unsupported ATIF format 'warc'

statement error
SELECT * FROM read_atif('test/data/trajectory.json', format = 'csv');
----
unsupported ATIF format

statement error
SELECT * FROM read_atif('test/data/records.warc', format = 'json');
----
ATIF read error

statement ok
SET preserve_insertion_order = false;

statement error
SELECT * FROM read_atif('test/data/trajectories.jsonl');
----
read_atif requires preserve_insertion_order = true

statement ok
RESET preserve_insertion_order;

query TIIT
SELECT trajectory_id,
       steps[1].message[2].source.path = (SELECT content FROM read_blob('test/data/atif-image.png')),
       steps[1].message[3].source.path = (SELECT content FROM read_blob('test/data/atif-audio.wav')),
       decode(steps[1].message[1].text)
FROM read_atif('test/data/trajectory_media.json');
----
media	true	true	hello 你好🙂

query IIT
SELECT steps[2].observation.results[1].content[2].source.path =
           (SELECT content FROM read_blob('test/data/atif-image.png')),
       steps[2].observation.results[1].content[3].source.path =
           (SELECT content FROM read_blob('test/data/atif-audio.wav')),
       decode(steps[2].observation.results[1].content[1].text)
FROM read_atif('test/data/trajectory_media.json');
----
true	true	RGB pattern and a 440 Hz tone.

query T
SELECT steps[1].message[1].source.path
FROM read_atif('test/data/trajectory_missing_media.json', resolve_media = false);
----
missing-image.png

query T
SELECT trajectory_id FROM read_atif('test/data/trajectory_missing_media.json');
----
media

statement error
SELECT steps FROM read_atif('test/data/trajectory_missing_media.json');
----
ATIF media

statement error
SELECT steps FROM read_atif('test/data/trajectory_media.json', max_media_bytes = 1);
----
max_media_bytes

statement error
SELECT * FROM read_atif('test/data/trajectory_media.json', max_trajectory_media_bytes = 0);
----
ATIF media byte limits must be positive

query I
COPY (SELECT * FROM read_atif('test/data/trajectory_media.json'))
TO '__TEST_DIR__/atif_media.lance' (FORMAT LANCE);
----
1

query I
COPY (SELECT * FROM read_atif('test/data/trajectories.jsonl'))
TO '__TEST_DIR__/atif_overrides.lance' (FORMAT LANCE,
    COLUMN_COMPRESSION {'STEPS.MESSAGE.TEXT': 'zstd', 'steps.observation.results.content.text': 'none'});
----
2

statement error
COPY (SELECT * FROM read_atif('test/data/trajectory.json'))
TO '__TEST_DIR__/invalid_atif_override.lance'
(FORMAT LANCE, COLUMN_COMPRESSION {'steps.message.missing': 'zstd'});
----
column not found

statement error
COPY (SELECT * FROM read_atif('test/data/trajectory.json'))
TO '__TEST_DIR__/invalid_atif_layout.lance'
(FORMAT LANCE, COLUMN_STRUCTURAL_ENCODING {'steps.message.text': 'fullzip'});
----
COLUMN_STRUCTURAL_ENCODING applies to top-level columns

restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

# The pinned upstream reader binds the physical nested Blob schema but returns
# logical Blob descriptors, causing an Arrow child-count mismatch for steps.
# Keep its SQL round trip to metadata until the reader fixes that mismatch.
# rust/tests/atif_media.rs verifies full text/media round trips with the writer SDK.
query TT
SELECT trajectory_id, agent.name
FROM '__TEST_DIR__/atif.lance'
ORDER BY trajectory_id;
----
t1	example
t2	example

query TI
SELECT trajectory_id, source_record_index FROM '__TEST_DIR__/atif_media.lance';
----
media	1
