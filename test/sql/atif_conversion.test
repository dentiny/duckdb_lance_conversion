# name: test/sql/atif_conversion.test
# description: ATIF trajectory JSON and JSONL to Lance datasets
# group: [sql]

require lance_conversion

query TIT
SELECT trajectory_id, source_record_index, agent.name
FROM read_atif('test/data/trajectories.jsonl')
ORDER BY source_record_index;
----
t1	1	example
t2	2	example

query TII
SELECT trajectory_id, len(steps), steps[2].metrics.prompt_tokens
FROM read_atif('test/data/trajectories.jsonl')
ORDER BY trajectory_id;
----
t1	2	10
t2	1	NULL

query TT
SELECT trajectory_id, steps[1].message[1].text
FROM read_atif('test/data/trajectory.json');
----
single	hello

query I
SELECT count(*) FROM read_atif('test/data/trajectories.jsonl', format = 'jsonl');
----
2

query I
COPY (
    SELECT * FROM read_atif('test/data/trajectories.jsonl')
) TO '__TEST_DIR__/atif.lance' (FORMAT LANCE);
----
2

statement error
SELECT * FROM read_atif('test/data/records.warc');
----
cannot infer ATIF format

statement error
SELECT * FROM read_atif('test/data/trajectory.json', format = 'csv');
----
unsupported ATIF format

statement error
SELECT * FROM read_atif('test/data/records.warc', format = 'json');
----
ATIF read error

restart no_extension_load

statement ok
LOAD '__BUILD_DIRECTORY__/extension/lance/lance.duckdb_extension'

query TI
SELECT trajectory_id, len(steps)
FROM '__TEST_DIR__/atif.lance'
ORDER BY trajectory_id;
----
t1	2
t2	1
